# ============================================
# NAPDOEE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# FRONTEND (VITE) VARIABLES
# ============================================

# API Backend URL
# - DEVELOPMENT: Leave empty (uses Vite proxy to localhost:3001)
# - PRODUCTION: Set to your Railway backend URL
# Example: VITE_API_URL=https://napdoee-api.up.railway.app
VITE_API_URL=

# ============================================
# BACKEND (EXPRESS) VARIABLES
# ============================================

# Database Connection String (PostgreSQL)
# - DEVELOPMENT: Use local PostgreSQL
# - PRODUCTION: Use Railway/Supabase PostgreSQL URL
# Format: postgresql://username:password@host:5432/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/napdoee

# JWT Secret for Authentication
# IMPORTANT: Generate a strong random secret for production!
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
# Default: 3001 (don't change for local development)
# Railway will auto-assign port in production
PORT=3001

# CORS Origin (Frontend URL)
# - DEVELOPMENT: http://localhost:5173 (Vite default)
# - PRODUCTION: Your Vercel frontend URL
# Example: CORS_ORIGIN=https://napdoee.vercel.app
CORS_ORIGIN=http://localhost:5173

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
#
# FOR RAILWAY (BACKEND):
# ✅ Set DATABASE_URL (from Railway PostgreSQL addon)
# ✅ Generate new JWT_SECRET (use crypto.randomBytes)
# ✅ Set CORS_ORIGIN (your Vercel URL)
# ✅ PORT is auto-set by Railway
#
# FOR VERCEL (FRONTEND):
# ✅ Set VITE_API_URL (your Railway backend URL)
#
# ============================================
