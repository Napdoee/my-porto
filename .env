# Environment Variables — Napdoee Backend

# Database — SQLite for local dev, change to PostgreSQL for production
# DATABASE_URL="file:./dev"

# For PostgreSQL production (DokPloy), uncomment and fill:
# DATABASE_URL="postgresql://user:pass@portfolio-db:5432/portfolio"
DATABASE_URL="postgresql://postgres:napdoee@localhost:5432/porto"

# JWT Secret — change to a random 256-bit string in production
JWT_SECRET="napdoee-dino-runner-jwt-secret-2026-change-in-prod"

# Server Port
PORT=3001

# CORS Origin — your frontend domain
CORS_ORIGIN="http://localhost:5173"
